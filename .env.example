# Copy this file to .env and fill in real values.
# .env is gitignored; this file is NOT — never put secrets here.

# Model Configuration
# HuggingFace model id
MODEL_NAME=bert-base-uncased
# Where downloaded weights are cached
MODEL_CACHE_DIR=./models/huggingface
# 128 is typical for sentiment; 512 is slower and uses more memory
MAX_SEQUENCE_LENGTH=128

# Training Configuration
# Lower to 8 if you run out of memory
BATCH_SIZE=16
# 2e-5 is the usual learning rate for BERT fine-tuning
LEARNING_RATE=0.00002
NUM_EPOCHS=3
# Mac: cpu (or mps on Apple Silicon). cuda = NVIDIA GPU only
DEVICE=cpu

# Data Configuration
# This folder must contain the 3 CSV files below
DATA_DIR=./data
# CSVs need columns: text,label  (label = 0 or 1)
TRAIN_FILE=train.csv
VAL_FILE=val.csv
TEST_FILE=test.csv

# Logging
LOG_LEVEL=INFO
LOG_FILE=training.log

# Weights & Biases (optional — leave API key blank to disable)
WANDB_API_KEY=
WANDB_PROJECT=sentiment-classifier
WANDB_ENTITY=your-wandb-username

# Database (for future use — not needed yet)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ml_experiments
DB_USER=mluser
DB_PASSWORD=
